# Generated by the hooks at runtime: local telemetry, never transmitted anywhere.
# See docs/telemetry.md.
.claude/hooks/state/

# Generated by generate_settings_json.py — yours, not ours.
# PROVENANCE.json is the sidecar it writes next to settings.json. It records
# the abs_root you generated with, so committing it would publish an absolute
# path from your machine. Ignored for that reason, not just for tidiness.
.claude/settings.json
.claude/settings.local.json
.claude/PROVENANCE.json
.claude/tools.json

